<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="ad100">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Name)" maxlength="255" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Vorname)" maxlength="255" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.SitzNeu)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.SitzEins)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.GebListe)"/>
    <SubmitButton class="btn btn-secondary col-md-1 ms-1" imageclass="bi bi-printer-fill-nav-menu" For="@(() => Model!.Print)"/>
    <SubmitButton class="btn btn-secondary col-md-1 ms-1" imageclass="bi bi-floppy-button" For="@(() => Model!.Floppy)"/>
    <SubmitButton class="btn btn-primary col-md-1 ms-1" imageclass="bi bi-arrow-clockwise-button" For="@(() => Model!.Refresh)"/>
    <SubmitButton class="btn btn-secondary col-md-1 ms-1" imageclass="bi bi-x-lg-button" For="@(() => Model!.Schliessen)"/>
  </div>
</EditForm>

@code {

  /// <summary>Holt oder setzt den betroffenen Service.</summary>
  [Inject]
  private CSBP.Services.Apis.Services.IStockService StockService { get; set; } = default!;

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id">Betroffene Id.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id, AD100Model? model = null, TableModelBase<AD100TableRowModel>? table = null)
  {
    var daten = ServiceDaten;
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new AD100Model
      {
        Nr = id,
      };
      Model.SetMhrf(DialogTypeEnum.New);
    }
    Model.Nr = id;
    if (table != null)
      Table = table;
    if (Table == null)
      Table = new TableModelBase<AD100TableRowModel>
      {
        SelectedPage = 1,
        RowsPerPage = 10,
        SelectedRow = 1,
        SortColumn = $"{nameof(AD100TodoModel.Nummer)}#+",
      };
    Table.Nr = id;
    InitEditContext(Model);
  }

  /// <summary>
  /// Initialisierung des Formulars kann wegen EditContext nicht asynchron sein:
  /// -Formular-Manager braucht eine Id, ansonsten Redirect mit neuer Guid.
  /// -Lesen des Models aus der Session, ansonsten Initialisierung des Models.
  /// </summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("AD100", "Personen - AD100", Id, true))
      return;

    // Alle Submit-Aktionen, die vor dem Rendern der Komponenten ausgeführt werden müssen.
    var handler = HttpContext.Request.Query["handler"];
    if (handler == "Table_All")
    {
      Model.SetMhrf(DialogTypeEnum.Copy);
      WriteFormularModel(Model.Nr ?? "0", Model);
    }
  }

  /// <summary>
  /// Dialog wird über Tabellen-Aktion informiert und kann für den Aufruf eines nicht modalen Dialogs benutzt werden.
  /// </summary>
  /// <param name="form">Betroffenes Postback-Formular.</param>
  /// <param name="handler">Handler aus Tabellen-Aktion.</param>
  /// <param name="id">Id aus Tabellen-Aktion.</param>
  public override void HandleNoModal(string? form, string? handler, string? id)
  {
    HandleNoModal1(form, handler, id, "AD110");
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    if (Valid && submit == "OK")
    {
      var daten = ServiceDaten;
      var r = new ServiceErgebnis(); // TODO xxxService.yyy(daten, Model.abc);
      if (r != null)
      {
        Get(r);
        if (r.Ok)
          return true;
      }
    }
    if (submit == nameof(Model.Refresh))
      Refresh();
    if (submit == nameof(Model.Schliessen))
      return true;
    return false;
  }

  /// <summary>
  /// Bereitstellen der Tabellen-Daten mit Berücksichtigung der Filterung, Sortierung und Paginierung.
  /// </summary>
  /// <param name="m">Betroffenes TableRowModel.</param>
  /// <param name="messages">Betroffene Fehlermeldungen.</param>
  /// <returns>Tabellen-Daten als Liste.</returns>
  protected override List<AD100TableRowModel> TableData(TableModelBase<AD100TableRowModel>? m, ValidationMessageStore? messages)
  {
    var rm = m?.ReadModel;
    var daten = ServiceDaten;
    var r = new ServiceErgebnis<List<AD100TodoModel>>(new List<AD100TodoModel>());
    r.Ergebnis?.Add(new AD100TodoModel()
    {
      Nummer = "1",
      Geschlecht1 = "Geschlecht11",
      Geschlecht2 = "Geschlecht21",
      Geschlecht3 = "Geschlecht31",
      PersonStatus1 = "PersonStatus11",
      PersonStatus2 = "PersonStatus21",
      Notiz = "Notiz1",
      SitzStatus1 = "SitzStatus11",
      SitzStatus2 = "SitzStatus21",
      SitzNr = "SitzNr1",
      AdressNr = "AdressNr1",
      Titel = "Titel1",
      Vorname = "Vorname1",
      Praedikat = "Praedikat1",
      Name1 = "Name11",
      Name2 = "Name21",
      Geschlecht0 = "Geschlecht01",
      Geburt = "Geburt1",
      PersonStatus0 = "PersonStatus01",
      Name = "Name1",
      Strasse = "Strasse1",
      Hausnr = "Hausnr1",
      Postfach = "Postfach1",
      Staat = "Staat1",
      Plz = "Plz1",
      Ort = "Ort1",
      Telefon = "Telefon1",
      Fax = "Fax1",
      Mobil = "Mobil1",
      Homepage = "Homepage1",
      Email = "Email1",
      SitzStatus0 = "SitzStatus01",
    });
    if (rm != null)
      rm.PageCount = 0;
    // TODO var l0 = Get(PrivateService.GetClientList(daten, rm), messages);
    var l = r.Ergebnis?.Select(a => AD100TableRowModel.From(a)).ToList() ?? new List<AD100TableRowModel>();
    return UpdateTable(m, rm, l);
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(AD100Model model, AD100Model model0)
  {
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }
}
