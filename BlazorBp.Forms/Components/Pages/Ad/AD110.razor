@page "/ad/ad110/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponent<AD110Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnSubmit="Submit" FormName="ad110">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  @* <InputText type="hidden" @bind-Value="Model!.ReadonlyHiddenError"/> *@
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Nummer)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.SitzNr)" VerticalColClass="form-group col-md-4 ms-1"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.AdressNr)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="radio" AutoPostback="" DataList="Model!.AuswahlPersonStatus" For="@(() => Model!.PersonStatus)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Titel)" VerticalColClass="form-group col-md-2 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Vorname)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Praedikat)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Name1)" VerticalColClass="form-group col-md-4 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Name2)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="radio" AutoPostback="" DataList="Model!.AuswahlGeschlecht" For="@(() => Model!.Geschlecht)" VerticalColClass="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.SitzStatus0)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.SitzStatus1)" VerticalColClass="form-group col-md-2 ms-1"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.SitzStatus2)" VerticalColClass="form-group col-md-2 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Name)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Strasse)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="" maxlength="20" For="@(() => Model!.Hausnr)" VerticalColClass="form-group col-md-4 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="10" For="@(() => Model!.Postfach)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" maxlength="3" For="@(() => Model!.Staat)" VerticalColClass="form-group col-md-4 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="10" For="@(() => Model!.Plz)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Ort)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Telefon)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Fax)" VerticalColClass="form-group col-md-4 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Mobil)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" maxlength="100" For="@(() => Model!.Homepage)" VerticalColClass="form-group col-md-4 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="40" For="@(() => Model!.Email)" VerticalColClass="form-group col-md-4 ms-1"/>
    <LabelInputValid AutoPostback="" maxlength="255" rows="3" For="@(() => Model!.Notiz)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.AdresseAnzahl)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Angelegt)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Geaendert)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-primary col-md-2 ms-1" For="@(() => Model!.Ok)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.AdresseDupl)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.AdresseWechseln)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Abbrechen)"/>
  </div>
</EditForm>

@code {
  /// <summary>Holt oder setzt den betroffenen Service.</summary>
  [Inject]
  private CSBP.Services.Apis.Services.IAddressService AddressService { get; set; } = default!;

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id0">Betroffene Id mit vorangestelltem Dialogtyp.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id0, AD110Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    var (dt, id) = Formular.GetDtId(id0);
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new AD110Model
      {
        DialogType = dt,
        Nr = id,
      };
      if (dt == DialogTypeEnum.Edit || dt == DialogTypeEnum.Delete || dt == DialogTypeEnum.Copy)
      {
        // Lesen des Models aus der Datenbank, z.B.:
        var r = AddressService.GetSite(daten, id ?? "");
        if (r.Ok && r.Ergebnis != null)
          Model.From(r.Ergebnis);
      }
      Model.SetMhrf(dt);
    }
    Model.Nr = id;
    InitEditContext(Model);
    // Lesen der Listen für Auswahlfelder.
    if (Model.AuswahlPersonStatus == null)
      Model.AuswahlPersonStatus = [ new ListItem("0", "Aktuell"), new ListItem("1", "Alt") ];
    if (Model.AuswahlGeschlecht == null)
      Model.AuswahlGeschlecht = [ new ListItem("N", "Neutrum"),new ListItem("M", "Männlich"), new ListItem("F", "Weiblich") ];
    // var l0 = Get(StockService.GetStateList(daten));
    // Model.AuswahlStatus = InsertEmpty(l0?.Select(a => new ListItem(a.Schluessel, a.Wert)).ToList());
  }

  /// <summary>Initialisierung der Komponente.</summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("AD110", "Person mit Sitz und Adresse - AD110", Id, false))
      return;
  }
 
  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    var daten = ServiceDaten;
    if (Valid && submit == nameof(Model.Ok))
    {
      // var o = Model.To(daten);
      // var r = Model.DialogType == DialogTypeEnum.Delete
      //   ? StockService.DeleteStock(daten, o)
      //   : StockService.SaveStock(daten, o.Uid, o.Bezeichnung, o.Kuerzel, o.SignalPrice1, o.Sorting, o.Datenquelle, o.Status, o.Relation_Uid, o.Notiz, o.Type, o.Currency, Model.Anlage);
      // if (r.Ok)
      // {
      //   SetFormRefresh();
      //   return true;
      // }
      // else
      //   Get(r, ModalMessages);
    }
    if (submit == nameof(Model.Abbrechen))
      return true;
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(AD110Model model, AD110Model model0)
  {
    model.DialogType = model0.DialogType;
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
    model.AuswahlPersonStatus = model0.AuswahlPersonStatus;
    model.AuswahlGeschlecht = model0.AuswahlGeschlecht;
  }
}
