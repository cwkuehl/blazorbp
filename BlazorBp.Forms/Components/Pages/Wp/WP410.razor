@page "/wp/wp410/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponent<WP410Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnSubmit="Submit" FormName="wp410">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Nummer)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid type="combobox" AutoPostback="x" For="@(() => Model!.Anlage)" DataList="@Model!.AuswahlAnlage" VerticalColClass="form-group col-md-4 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Valuta)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Preis)" VerticalColClass="form-group col-md-2 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Betrag)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Rabatt)" VerticalColClass="form-group col-md-2 ms-1"/>
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Anteile)" VerticalColClass="form-group col-md-2 ms-1"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Preis2)" VerticalColClass="form-group col-md-2 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Zinsen)" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.BText)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid type="checkbox" class="form-control" NoLabel="false" TrailingLabel="false" AutoPostback="" For="@(() => Model!.Fixtext)" VerticalColClass="form-group col-md-2 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Angelegt)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Geaendert)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Buchung)" VerticalColClass="form-group col"/>
  </div>
  <hr/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Hhbuchung)" VerticalColClass="form-group col-md-2"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.HhAendern)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.HhStorno)"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Hhvaluta)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Hhbetrag)" VerticalColClass="form-group col-md-2 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="x" type="listbox" size="8" DataList="Model!.AuswahlHhEreignis" For="@(() => Model!.HhEreignis)" VerticalColClass="form-group col-md-4"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-primary col-md-2 ms-1" For="@(() => Model!.Ok)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Abbrechen)"/>
  </div>
</EditForm>

@code {
  /// <summary>Holt oder setzt den betroffenen Service.</summary>
  [Inject]
  private CSBP.Services.Apis.Services.IStockService StockService { get; set; } = default!;

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id0">Betroffene Id mit vorangestelltem Dialogtyp.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id0, WP410Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    var (dt, id) = Formular.GetDtId(id0);
    if (model != null)
      Model = model;
    if (Model == null)
    {
      var valuta = Functions.ToDateTime(GetStringData("WP410Valuta")) ?? daten.Heute;
      Model = new WP410Model
      {
        DialogType = dt,
        Nr = id,
        Valuta = valuta,
        Hhvaluta = valuta,
      };
      if (dt == DialogTypeEnum.Edit || dt == DialogTypeEnum.Delete || dt == DialogTypeEnum.Copy)
      {
        // Lesen des Models aus der Datenbank.
        var r = StockService.GetBooking(daten, id ?? "");
        if (r.Ok && r.Ergebnis != null)
        {
          var k = r.Ergebnis;
          HhBuchung? b = null;
          if (dt == DialogTypeEnum.Copy)
            k.BookingUid = null;
          if (!string.IsNullOrEmpty(k.BookingUid))
          {
            b = Get(FactoryService.BudgetService.GetBooking(daten, k.BookingUid));
            if (b != null)
              EventList(k.Anlage_Uid);
          }
          Model.From(k, b);
          OnShares();
        }
      }
      else if (dt == DialogTypeEnum.New)
      {
        Model.Anlage = GetStringData("WP400Anlage");
      }
      Model.SetMhrf(dt);
    }
    Model.Nr = id;
    InitEditContext(Model);

    // Lesen der Listen für Auswahlfelder.
    if (Model.AuswahlAnlage == null)
    {
      var l0 = Get(StockService.GetInvestmentList(daten, null, true));
      Model.AuswahlAnlage = InsertEmpty(l0?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList() ?? []);
    }
    if (Model.AuswahlHhEreignis == null)
    {
      EventList(Model.Anlage);
    }
  }

  /// <summary>Initialisierung der Komponente.</summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("WP410", "WP-Buchung - WP410", Id, false))
      return;
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    var daten = ServiceDaten;
    if (submit == nameof(Model.Anlage))
      OnValuta();
    if (IsDateMhp(submit, nameof(Model.Valuta), Model.Valuta, out var d))
    {
      if (d.HasValue)
      {
        Model.Valuta = d;
        OnValuta();
      }
    }
    if (submit == nameof(Model.Valuta))
      OnValuta();
    if (submit == nameof(Model.Betrag) || submit == nameof(Model.Rabatt) || submit == nameof(Model.Anteile) || submit == nameof(Model.Zinsen))
      OnShares();
    if (IsDateMhp(submit, nameof(Model.Hhvaluta), Model.Hhvaluta, out var d2))
    {
      if (d2.HasValue)
        Model.Hhvaluta = d2;
    }
    if (submit == nameof(Model.HhEreignis))
    {
      var euid = Model.HhEreignis;
      var ev = Model.AuswahlHhEreignis0?.FirstOrDefault(a => a.Uid == euid);
      var text = ev?.Bezeichnung;
      if (!string.IsNullOrEmpty(text))
      {
        if (!Model.Fixtext)
          Model.BText = text;
        if (ev?.EText == "1")
        {
          // Shares without interests.
          Model.Zinsen = "";
        }
        else if (ev?.EText == "2")
        {
          // Interests without changes of shares.
          Model.Betrag = "";
          //// Model.Rabatt = "";
          Model.Anteile = "";
        }
      }
    }
    if (submit == nameof(Model.HhAendern) && !string.IsNullOrEmpty(Model.Hhbuchung))
    {
      // TODO HH410 Edit;
    }
    if (submit == nameof(Model.HhStorno) && !string.IsNullOrEmpty(Model.Hhbuchung))
    {
      // TODO HH410 Reverse;
    }
    if (Valid && submit == nameof(Model.Ok))
    {
      ServiceErgebnis? r = null;
      if (Model.DialogType == DialogTypeEnum.New || Model.DialogType == DialogTypeEnum.Copy
        || Model.DialogType == DialogTypeEnum.Edit)
      {
        var o = Model.To(daten);
        var euid = Model.HhEreignis;
        var ev = Model.AuswahlHhEreignis0?.FirstOrDefault(a => a.Uid == euid);
        var booktext = Model.BText ?? ev?.Bezeichnung;
        var rb = StockService.SaveBooking(daten,
          o.Uid, o.Anlage_Uid, o.Datum, o.Zahlungsbetrag, o.Rabattbetrag,
          o.Anteile, o.Zinsen, Model.BText, null,
          Functions.ToDecimal(Model.Preis, 4) ?? 0, Model.Hhbuchung, Model.Hhvaluta ?? daten.Heute,
          Functions.ToDecimal(Model.Hhbetrag, 2) ?? 0, ev?.Soll_Konto_Uid, ev?.Haben_Konto_Uid, booktext);
        r = rb;
        if (rb.Ok && rb.Ergebnis != null)
        {
          //// if (Model.DialogType == DialogTypeEnum.New)
          ////  Model.Hhbuchung = rb.Ergebnis.BookingUid; // Quatsch
          ////if (Model.DialogType == DialogTypeEnum.Copy)
            ////   Lastcopyuid = rb.Ergebnis.Uid;
        }
      }
      else if (Model.DialogType == DialogTypeEnum.Delete)
      {
        var o = Model.To(daten);
        r = FactoryService.StockService.DeleteBooking(ServiceDaten, o);
      }
      if (r != null)
      {
        Get(r);
        if (r.Ok)
        {
          SetStringData("WP410Valuta", Funktionen.ToString(Model.Valuta));
          if (Model.DialogType == DialogTypeEnum.New)
          {
            var desc = Model.AuswahlAnlage?.FirstOrDefault(a => a.Key == Model.Anlage)?.Value;
            Model.Buchung = WP030(Model.Valuta ?? daten.Heute, Model.Betrag, Model.Rabatt, Model.Anteile, Model.Zinsen, desc, Model.BText);
            Model.Betrag = "";
            Model.Rabatt = "";
            Model.Anteile = "";
            Model.Zinsen = "";
            OnShares();
            Model.Focus = nameof(Model.Betrag);
            WriteFormularModel(Model.Nr ?? "0", Model);
            ForceRefresh();
          }
          else
          {
            SetFormRefresh();
            return true;
          }
        }
      }
    }
    if (submit == nameof(Model.Abbrechen))
    {
      SetFormRefresh();
      return true;
    }
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(WP410Model model, WP410Model model0)
  {
    model.DialogType = model0.DialogType;
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
    model.AuswahlAnlage = model0.AuswahlAnlage;
    model.AuswahlHhEreignis0 = model0.AuswahlHhEreignis0;
    model.AuswahlHhEreignis = model0.AuswahlHhEreignis;
    model.AnlageEreignis = model0.AnlageEreignis;
  }

    /// <summary>Handles valuta.</summary>
  private void OnValuta()
  {
    var daten = ServiceDaten;
    var inuid = Model.Anlage;
    var inv = string.IsNullOrWhiteSpace(inuid) ? null :
      Get(FactoryService.StockService.GetInvestment(daten, inuid));
    var p = inv == null || !Model.Valuta.HasValue ? null :
      Get(FactoryService.StockService.GetPrice(daten, inv.Wertpapier_Uid, Model.Valuta.Value));
    Model.Preis = Funktionen.ToString(p?.Stueckpreis, 4);
    if (string.IsNullOrEmpty(Model.Hhbuchung))
      Model.Hhvaluta = Model.Valuta;
    EventList(inuid);
  }

  /// <summary>Handles shares.</summary>
  private void OnShares()
  {
    var p = Functions.ToDecimal(Model.Betrag);
    var s = Functions.ToDecimal(Model.Anteile);
    var z = Functions.ToDecimal(Model.Zinsen) ?? 0;
    Model.Preis2 = Funktionen.ToString(Functions.CompDouble4(p, 0) == 0 || Functions.CompDouble4(s, 0) == 0 ? null : p / s, 6);
    if (string.IsNullOrEmpty(Model.Hhbuchung))
    {
      if (z == 0)
        Model.Hhbetrag = Funktionen.ToString(Math.Abs((p ?? 0) - (Functions.ToDecimal(Model.Rabatt) ?? 0)), 2);
      else
        Model.Hhbetrag = Funktionen.ToString(Math.Abs(z + (Functions.ToDecimal(Model.Rabatt) ?? 0)), 2);
    }
  }

  /// <summary>Handles event list.</summary>
  /// <param name="inuid">Affected investment uid.</param>
  private void EventList(string? inuid)
  {
    if (Model.AnlageEreignis != inuid || (Model.AuswahlHhEreignis == null && string.IsNullOrEmpty(inuid)))
    {
      var le = Get(FactoryService.StockService.GetEventList(ServiceDaten, inuid)) ?? new List<HhEreignis>();
      Model.AuswahlHhEreignis0 = le;
      Model.AuswahlHhEreignis = InsertEmpty(le?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList() ?? []);
      Model.AnlageEreignis = inuid;
    }
  }
}
