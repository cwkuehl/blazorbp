    <TableColumn Field="@nameof(WP400TableRowModel.Anteile)" SortField="@nameof(WP400TodoModel.Anteile)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Preis2)" SortField="@nameof(WP400TodoModel.Preis2)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
