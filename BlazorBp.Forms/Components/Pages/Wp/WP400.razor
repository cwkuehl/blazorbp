@page "/wp/wp400/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponent<WP400Model, WP400TableRowModel>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
<SortableTable Table="Table" NoData="" FormName="wp400" NoModal="true" EditAktion="true" DeleteAktion="true" ReverseAktion="false" CopyAktion="true" NewAktion="true" TModel="WP400Model" TRTable="WP400TableRowModel">
  <ChildContent>
    <TableColumn Field="@nameof(WP400TableRowModel.Nummer)" SortField="@nameof(WpBuchung.Uid)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Wertpapier)" SortField="@nameof(WpBuchung.StockDescription)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Anlage)" SortField="@nameof(WpBuchung.InvestmentDescription)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Valuta)" SortField="@nameof(WpBuchung.Datum)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.BText)" SortField="@nameof(WpBuchung.BText)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Betrag)" SortField="@nameof(WpBuchung.Zahlungsbetrag)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Rabatt)" SortField="@nameof(WpBuchung.Rabattbetrag)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Anteile)" SortField="@nameof(WpBuchung.Anteile)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.Zinsen)" SortField="@nameof(WpBuchung.Zinsen)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.AngelegtAm)" SortField="@nameof(WpBuchung.Angelegt_Am)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.AngelegtVon)" SortField="@nameof(WpBuchung.Angelegt_Von)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.GeaendertAm)" SortField="@nameof(WpBuchung.Geaendert_Am)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
    <TableColumn Field="@nameof(WP400TableRowModel.GeaendertVon)" SortField="@nameof(WpBuchung.Geaendert_Von)" TModel="WP400Model" TRTable="WP400TableRowModel"/>
  </ChildContent>
</SortableTable>
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="wp400">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid type="combobox" AutoPostback="x" For="@(() => Model!.Anlage)" DataList="@Model!.AuswahlAnlage" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Von)" VerticalColClass="form-group col-md-4 ms-1"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-primary col-md-2 ms-1" imageclass="bi bi-arrow-clockwise-button" For="@(() => Model!.Refresh)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-x-lg-button" For="@(() => Model!.Schliessen)"/>
  </div>
</EditForm>

@code {
  /// <summary>Holt oder setzt den betroffenen Service.</summary>
  [Inject]
  private CSBP.Services.Apis.Services.IStockService StockService { get; set; } = default!;

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id">Betroffene Id.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id, WP400Model? model = null, TableModelBase<WP400TableRowModel>? table = null)
  {
    var daten = ServiceDaten;
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new WP400Model
      {
        Nr = id,
      };
      Model.SetMhrf(DialogTypeEnum.New, daten);
      var arr = HttpContext?.Session?.GetFormParameter() ?? [];
      var inuid = arr.Length > 0 ? arr[0] : "";
      if (string.IsNullOrEmpty(inuid))
        inuid = GetStringData("WP400Anlage");
      if (!string.IsNullOrEmpty(inuid))
      {
        Model.Anlage = inuid;
        SetStringData("WP400Anlage", inuid);
        Model.Von = null;
      }
    }
    Model.Nr = id;
    if (table != null)
      Table = table;
    if (Table == null)
      Table = new TableModelBase<WP400TableRowModel>
      {
        SelectedPage = 1,
        RowsPerPage = 10,
        SelectedRow = 1,
        SortColumn = $"{nameof(WpBuchung.Datum)}#-",
      };
    Table.Nr = id;
    InitEditContext(Model);

    // Lesen der Listen für Auswahlfelder.
    if (Model.AuswahlAnlage == null)
    {
      var l0 = Get(StockService.GetInvestmentList(daten, null, false));
      Model.AuswahlAnlage = InsertEmpty(l0?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList() ?? []);
    }
    @* var v = GetStringData("WP410Anlage");
    if (!string.IsNullOrEmpty(v))
    {
      // Liste für zuletzt gebuchte Anlage.
      SetStringData("WP410Anlage", null);
      Model.Anlage = v;
      WriteFormularModel(Model.Nr ?? "0", Model);
      Refresh();
    } *@
  }

  /// <summary>
  /// Initialisierung des Formulars kann wegen EditContext nicht asynchron sein:
  /// -Formular-Manager braucht eine Id, ansonsten Redirect mit neuer Guid.
  /// -Lesen des Models aus der Session, ansonsten Initialisierung des Models.
  /// </summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("WP400", "WP-Buchungen - WP400", Id, true))
      return;

    // Alle Submit-Aktionen, die vor dem Rendern der Komponenten ausgeführt werden müssen.
    var handler = HttpContext.Request.Query["handler"];
    if (handler == "Table_All")
    {
      Model.SetMhrf(DialogTypeEnum.Copy, ServiceDaten);
      if (string.IsNullOrEmpty(Model.Anlage))
        Model.Anlage = GetStringData("WP400Anlage");
      WriteFormularModel(Model.Nr ?? "0", Model);
    }
  }

  /// <summary>
  /// Dialog wird über Tabellen-Aktion informiert und kann für den Aufruf eines nicht modalen Dialogs benutzt werden.
  /// </summary>
  /// <param name="form">Betroffenes Postback-Formular.</param>
  /// <param name="handler">Handler aus Tabellen-Aktion.</param>
  /// <param name="id">Id aus Tabellen-Aktion.</param>
  public override void HandleNoModal(string? form, string? handler, string? id)
  {
    HandleNoModal1(form, handler, id, "WP410");
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    if (IsDateMhp(submit, nameof(Model.Von), Model.Von, out var d))
    {
      if (d.HasValue)
        Model.Von = d;
    }
    if (submit == nameof(Model.Anlage) || (submit?.StartsWith(nameof(Model.Von)) ?? false) || submit == nameof(Model.Refresh))
    {
      if (string.IsNullOrEmpty(Model.Anlage) && !Model.Von.HasValue)
        Model.SetMhrf(DialogTypeEnum.New, ServiceDaten);
      Refresh();
    }
    if (submit == nameof(Model.Schliessen))
      return true;
    return false;
  }

  /// <summary>
  /// Bereitstellen der Tabellen-Daten mit Berücksichtigung der Filterung, Sortierung und Paginierung.
  /// </summary>
  /// <param name="m">Betroffenes TableRowModel.</param>
  /// <param name="messages">Betroffene Fehlermeldungen.</param>
  /// <returns>Tabellen-Daten als Liste.</returns>
  protected override List<WP400TableRowModel> TableData(TableModelBase<WP400TableRowModel>? m, ValidationMessageStore? messages)
  {
    var rm = m?.ReadModel;
    var daten = ServiceDaten;
    var l0 = Get(StockService.GetBookingList(daten, rm, inuid: Model.Anlage, from: Model.Von), messages);
    var l = l0?.Select(a => WP400TableRowModel.From(a)).ToList() ?? new List<WP400TableRowModel>();
    return UpdateTable(m, rm, l);
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(WP400Model model, WP400Model model0)
  {
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
    model.AuswahlAnlage = model0.AuswahlAnlage;
  }
}
