@page "/fz/fz100/{id?}"
@using CSBP.Services.Apis.Models
@using static CSBP.Services.Resources.M;
@using static CSBP.Services.Resources.Messages;
@inherits BlazorComponentBase<FZ100Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="fz100">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row g-0">
    <div class="col-md-6">
      <div class="row mt-1 g-0">
        <LabelInputValid AutoPostback="" For="@(() => Model!.Datum)" VerticalColClass="form-group col-md-4"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid rows="11" AutoPostback="" For="@(() => Model!.Bilanz)" VerticalColClass="form-group col"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid rows="12" AutoPostback="" For="@(() => Model!.Buecher)" VerticalColClass="form-group col"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid rows="10" AutoPostback="" For="@(() => Model!.Fahrrad)" VerticalColClass="form-group col"/>
      </div>
    </div>
    <div class="col ms-1">
      <div class="row mt-1 g-0">
        <LabelInputValid type="canvas" width="@CanvasWidth" height="@CanvasHeight" AutoPostback="" For="@(() => Model!.Diagram)" VerticalColClass="form-group col" class="w-100 border border-dark rounded"/>
      </div>
    </div>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-arrow-clockwise" For="@(() => Model!.Refresh)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-x-lg" For="@(() => Model!.Schliessen)"/>
  </div>
</EditForm>

<script type="application/json" id="canvasdata">
@((MarkupString)CanvasDaten)
</script>

@code {
  /// <summary>Holt oder setzt die Canvas-Daten.</summary>
  private string CanvasDaten = "";

  /// <summary>Holt oder setzt die Canvas-Breite.</summary>
  private string CanvasWidth = "400";

  /// <summary>Holt oder setzt die Canvas-Höhe.</summary>
  private string CanvasHeight = "510";

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id">Betroffene Id.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id, FZ100Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new FZ100Model
      {
        Nr = id,
      };
      Model.SetMhrf(DialogTypeEnum.New, daten);
      Refresh();
    }
    Model.Nr = id;
    InitEditContext(Model);
  }

  /// <summary>
  /// Aktualisierung nach Undo/Redo.
  /// </summary>
  protected override void Refresh()
  {
    var daten = ServiceDaten;
    var datum = Model.Datum ?? daten.Heute;
    var str = Get(FactoryService.PrivateService.GetStatistics(daten, 1, datum));
    Model.Bilanz = str;
    str = Get(FactoryService.PrivateService.GetStatistics(daten, 2, datum));
    Model.Buecher = str;
    str = Get(FactoryService.PrivateService.GetStatistics(daten, 3, datum));
    Model.Fahrrad = str;

    var l = Get(FactoryService.BudgetService.GetProprietaryPlList(daten, datum));
    l?.Reverse();
    var pplList = l?.Select(a => new KeyValuePair<string, decimal>(Functions.ToString(a.Geaendert_Am), a.EBetrag)).ToList();
    var l2 = Get(FactoryService.PrivateService.GetMileages(daten, datum));
    var mileageList = l2?.Select(a => new KeyValuePair<string, decimal>(Functions.ToString(a.Datum), a.Periode_km)).ToList();
    if (pplList != null && mileageList != null)
    {
      var ctx = new CanvasCompiler();
      ctx.AddControl(nameof(Model.Diagram));
      var w = Functions.ToInt32(CanvasWidth);
      var h = Functions.ToInt32(CanvasHeight);
      Diagram.Draw(M0(HH001), pplList, ctx, 0, 0, w, h / 2);
      Diagram.Draw(M0(FZ044), mileageList, ctx, 0, h / 2, w, h / 2);
      CanvasDaten = ctx.Compile();
    }
  }

  /// <summary>
  /// Initialisierung des Formulars kann wegen EditContext nicht asynchron sein:
  /// -Formular-Manager braucht eine Id, ansonsten Redirect mit neuer Guid.
  /// -Lesen des Models aus der Session, ansonsten Initialisierung des Models.
  /// </summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("FZ100", "Statistik - FZ100", Id, true))
      return;
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    if (IsDateMhp(submit, nameof(Model.Datum), Model.Datum, out var d))
    {
      if (d.HasValue)
      {
        Model.Datum = d;
        WriteFormularModel(Model.Nr ?? "0", Model);
        Refresh();
      }
    }
    if (submit == nameof(Model.Refresh))
        Refresh();
    if (submit == nameof(Model.Schliessen))
      return true;
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(FZ100Model model, FZ100Model model0)
  {
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }
}
