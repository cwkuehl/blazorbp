@page "/wp/wp500/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<WP500Model, WP500TableRowModel>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
<SortableTable Table="Table" NoData="" FormName="wp500" NoModal="true" EditAktion="true" DeleteAktion="true" CopyAktion="true" NewAktion="true" TModel="WP500Model" TRTable="WP500TableRowModel">
  <ChildContent>
    <TableColumn Field="@nameof(WP500TableRowModel.Wertpapier)" SortField="@nameof(WpStand.StockDescription)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.Valuta)" SortField="@nameof(WpStand.Datum)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.Betrag)" SortField="@nameof(WpStand.Stueckpreis)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.AngelegtAm)" SortField="@nameof(WpStand.Angelegt_Am)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.AngelegtVon)" SortField="@nameof(WpStand.Angelegt_Von)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.GeaendertAm)" SortField="@nameof(WpStand.Geaendert_Am)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.GeaendertVon)" SortField="@nameof(WpStand.Geaendert_Von)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
  </ChildContent>
</SortableTable>
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="wp500">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid type="combobox" AutoPostback="x" For="@(() => Model!.Wertpapier)" DataList="@Model!.AuswahlWertpapier" VerticalColClass="form-group col-md-2"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Thin)"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Von)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Bis)" VerticalColClass="form-group col-md-2 ms-1"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-arrow-clockwise" For="@(() => Model!.Refresh)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-x-lg" For="@(() => Model!.Schliessen)"/>
  </div>
</EditForm>

@code {

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id">Betroffene Id.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id, WP500Model? model = null, TableModelBase<WP500TableRowModel>? table = null)
  {
    var daten = ServiceDaten;
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new WP500Model
      {
        Nr = id,
      };
      Model.SetMhrf(DialogTypeEnum.New, daten);
    }
    Model.Nr = id;
    if (table != null)
      Table = table;
    if (Table == null)
      Table = new TableModelBase<WP500TableRowModel>
      {
        SelectedPage = 1,
        RowsPerPage = 20,
        SelectedRow = 1,
        SortColumn = $"{nameof(WpStand.StockDescription)}#+",
      };
    Table.Nr = id;
    InitEditContext(Model);

    // Lesen der Listen für Auswahlfelder
    var l0 = Get(FactoryService.StockService.GetStockList(daten));
    Model.AuswahlWertpapier = InsertEmpty(l0?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList());
    if (string.IsNullOrEmpty(Model.Wertpapier))
      Model.Wertpapier = GetStringData("WP500Wertpapier");
  }

  /// <summary>
  /// Initialisierung des Formulars kann wegen EditContext nicht asynchron sein:
  /// -Formular-Manager braucht eine Id, ansonsten Redirect mit neuer Guid.
  /// -Lesen des Models aus der Session, ansonsten Initialisierung des Models.
  /// </summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("WP500", "Stände - WP500", Id, true))
      return;

    // Alle Submit-Aktionen, die vor dem Rendern der Komponenten ausgeführt werden müssen.
    var handler = HttpContext.Request.Query["handler"];
    if (handler == "Table_All")
    {
      Model.SetMhrf(DialogTypeEnum.Copy, ServiceDaten);
      WriteFormularModel(Model.Nr ?? "0", Model);
    }
    SetStringData("WP500Wertpapier", Model.Wertpapier);
  }

  /// <summary>
  /// Dialog wird über Tabellen-Aktion informiert und kann für den Aufruf eines nicht modalen Dialogs benutzt werden.
  /// </summary>
  /// <param name="form">Betroffenes Postback-Formular.</param>
  /// <param name="handler">Handler aus Tabellen-Aktion.</param>
  /// <param name="id">Id aus Tabellen-Aktion.</param>
  public override void HandleNoModal(string? form, string? handler, string? id)
  {
    HandleNoModal1(form, handler, id, "WP510");
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    if (submit == nameof(Model.Thin))
    {
      var daten = ServiceDaten;
      var r = FactoryService.StockService.ThinPrices(daten, Model.Von ?? daten.Heute, Model.Wertpapier);
      if (Get(r))
      {
        Model.Focus = nameof(Model.Wertpapier);
        WriteFormularModel(Model.Nr ?? "0", Model);
        Refresh();
      }
    }
    if (Table != null && submit == nameof(Model.Wertpapier))
    {
      Refresh();
    }
    if (IsDateMhp(submit, nameof(Model.Von), Model.Von, out var d))
    {
      if (d.HasValue)
      {
        Model.Von = d;
        WriteFormularModel(Model.Nr ?? "0", Model);
        Refresh();
      }
    }
    if (IsDateMhp(submit, nameof(Model.Bis), Model.Bis, out var db))
    {
      if (db.HasValue)
      {
        Model.Bis = db;
        WriteFormularModel(Model.Nr ?? "0", Model);
        Refresh();
      }
    }
    if (submit == nameof(Model.Schliessen))
      return true;
    return false;
  }

  /// <summary>
  /// Bereitstellen der Tabellen-Daten mit Berücksichtigung der Filterung, Sortierung und Paginierung.
  /// </summary>
  /// <param name="m">Betroffenes TableRowModel.</param>
  /// <param name="messages">Betroffene Fehlermeldungen.</param>
  /// <returns>Tabellen-Daten als Liste.</returns>
  protected override List<WP500TableRowModel> TableData(TableModelBase<WP500TableRowModel>? m, ValidationMessageStore? messages)
  {
    var rm = m?.ReadModel;
    var daten = ServiceDaten;
    var l0 = Get(FactoryService.StockService.GetPriceList(daten, rm, Model.Wertpapier, Model.Von, Model.Bis), messages);
    var l = l0?.Select(a => WP500TableRowModel.From(a)).ToList() ?? new List<WP500TableRowModel>();
    return UpdateTable(m, rm, l);
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(WP500Model model, WP500Model model0)
  {
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }
}
