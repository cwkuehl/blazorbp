@page "/wp/wp500/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<WP500Model, WP500TableRowModel>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
<SortableTable Table="Table" NoData="" FormName="wp500" NoModal="true" EditAktion="true" DeleteAktion="true" CopyAktion="true" NewAktion="true" TModel="WP500Model" TRTable="WP500TableRowModel">
  <ChildContent>
    <TableColumn Field="@nameof(WP500TableRowModel.Wertpapier)" SortField="@nameof(WP500TodoModel.Wertpapier)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.Valuta)" SortField="@nameof(WP500TodoModel.Valuta)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.Betrag)" SortField="@nameof(WP500TodoModel.Betrag)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.AngelegtAm)" SortField="@nameof(WP500TodoModel.Angelegt_Am)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.AngelegtVon)" SortField="@nameof(WP500TodoModel.Angelegt_Von)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.GeaendertAm)" SortField="@nameof(WP500TodoModel.Geaendert_Am)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
    <TableColumn Field="@nameof(WP500TableRowModel.GeaendertVon)" SortField="@nameof(WP500TodoModel.Geaendert_Von)" TModel="WP500Model" TRTable="WP500TableRowModel"/>
  </ChildContent>
</SortableTable>
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="wp500">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
  </div>
  <div class="row mt-1 g-0">
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Refresh)"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Staende)" maxlength="255" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Wertpapier)" maxlength="255" VerticalColClass="form-group col-md-2"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Thin)"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Von)" maxlength="255" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Bis)" maxlength="255" VerticalColClass="form-group col-md-2"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.All)"/>
  </div>
  <div class="row mt-1 g-0">
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Schliessen)"/>
  </div>
  <!-- TODO btn-primary festlegen -->
</EditForm>

