@page "/wp/wp210/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<WP210Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="wp210">
  @* <DataAnnotationsValidator/> *@
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <InputText type="hidden" @bind-Value="Model!.ReadonlyHiddenError"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Nummer)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Bezeichnung)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Provider)" DataList="Model!.AuswahlProvider" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Kuerzel)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Status)" DataList="Model!.AuswahlStatus" VerticalColClass="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.AktKurs)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.StopKurs)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.SignalKurs1)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Muster)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Typ)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Waehrung)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Sortierung)" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Relation)" DataList="Model!.AuswahlRelation" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid rows="3" AutoPostback="" For="@(() => Model!.Notiz)" VerticalColClass="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Angelegt)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Geaendert)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="checkbox" AutoPostback="" For="@(() => Model!.Anlage)" VerticalColClass="form-group col-md-4"/>
    <SubmitButton class="btn btn-primary col-md-2 ms-1" For="@(() => Model!.Ok)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-x-lg" For="@(() => Model!.Abbrechen)"/>
  </div>
</EditForm>

@code {
  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id0">Betroffene Id mit vorangestelltem Dialogtyp.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id0, WP210Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    var (dt, id) = Formular.GetDtId(id0);
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new WP210Model
      {
        DialogType = dt,
        Nr = id,
      };
      if (dt == DialogTypeEnum.Edit || dt == DialogTypeEnum.Delete || dt == DialogTypeEnum.Copy)
      {
        // Model.SetMhrf(dt);
        var r = FactoryService.StockService.GetStock(daten, id ?? "");
        if (r.Ok && r.Ergebnis != null)
          Model.From(r.Ergebnis);
      }
      Model.SetMhrf(dt);
    }
    Model.Nr = id;
    InitEditContext(Model);
    var l0 = Get(FactoryService.StockService.GetStateList(daten));
    Model.AuswahlStatus = l0?.Select(a => new ListItem(a.Schluessel, a.Wert)).ToList();
    var l1 = Get(FactoryService.StockService.GetProviderList(daten));
    Model.AuswahlProvider = l1?.Select(a => new ListItem(a.Schluessel, a.Wert)).ToList();
    var l2 = Get(FactoryService.StockService.GetStockList(daten));
    Model.AuswahlRelation = InsertEmpty(l2?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList());
  }

  /// <summary>Initialisierung der Komponente.</summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("WP210", "Wertpapier - WP210", Id, false))
      return;
  }
 
  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    var daten = ServiceDaten;
    if (valid && submit == nameof(Model.Ok))
    {
      var o = Model.To(daten);
      var r = Model.DialogType == DialogTypeEnum.Delete
        ? FactoryService.StockService.DeleteStock(daten, o)
        : FactoryService.StockService.SaveStock(daten, o.Uid, o.Bezeichnung, o.Kuerzel, o.SignalPrice1, o.Sorting, o.Datenquelle, o.Status, o.Relation_Uid, o.Notiz, o.Type, o.Currency, Model.Anlage);
      if (r.Ok)
      {
        Model.ModalArt = null;
        Model.ModalId = null;
        Refresh();
        return true;
      }
      else
        Get(r, ModalMessages);
    }
    if (submit == nameof(Model.Abbrechen))
      return true; // Model beim Schließen löschen.
    return false;
  }
}
