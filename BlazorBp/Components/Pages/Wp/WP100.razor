@page "/wp/wp100/{id?}"
@using CSBP.Services.Apis.Models
@using CSBP.Services.Pnf;
@inherits BlazorComponentBase<WP100Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<EditForm Enhance method="post" EditContext="EditContext" OnSubmit="Submit" FormName="wp100">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row g-0">
    <div class="col-md-6">
      <div class="row mt-1 g-0">
        <LabelInputValid type="listbox" size="10" AutoPostback="" DataList="Model!.AuswahlData" For="@(() => Model!.Data)" maxlength="255" VerticalColClass="form-group col"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid AutoPostback="" For="@(() => Model!.Von)" VerticalColClass="form-group col-md-4"/>
        <LabelInputValid AutoPostback="" For="@(() => Model!.Bis)" VerticalColClass="form-group col ms-1"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid type="combobox" AutoPostback="x" For="@(() => Model!.Wertpapier)" DataList="@Model!.AuswahlWertpapier" VerticalColClass="form-group col"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid step="0.001" AutoPostback="" For="@(() => Model!.Box)" VerticalColClass="form-group col-md-4"/>
        <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Skala)" maxlength="255" DataList="@Model!.AuswahlSkala" VerticalColClass="form-group col ms-1"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid AutoPostback="" For="@(() => Model!.Umkehr)" maxlength="255" VerticalColClass="form-group col-md-4"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Methode)" maxlength="255" DataList="@Model!.AuswahlMethode" VerticalColClass="form-group col"/>
        <LabelInputValid type="checkbox" TrailingLabel="true" AutoPostback="" For="@(() => Model!.Relativ)" VerticalColClass="form-group col-md-2"/>
      </div>
    </div>
    <div class="col ms-1">
      <div class="row mt-1 g-0">
        <LabelInputValid type="canvas" width="@CanvasWidth" height="@CanvasHeight" AutoPostback="" For="@(() => Model!.Chart)" VerticalColClass="form-group col" class="w-100 border border-dark rounded"/>
      </div>
    </div>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-arrow-clockwise" For="@(() => Model!.Refresh)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-x-lg" For="@(() => Model!.Schliessen)"/>
  </div>
</EditForm>

<script type="application/json" id="canvasdata">
@((MarkupString)CanvasDaten)
</script>

@code {

  /// <summary>Holt oder setzt die Canvas-Daten.</summary>
  private string CanvasDaten = "";

  /// <summary>Holt oder setzt die Canvas-Breite.</summary>
  private string CanvasWidth = "400";

  /// <summary>Holt oder setzt die Canvas-Höhe.</summary>
  private string CanvasHeight = "510";

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id">Betroffene Id.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id, WP100Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new WP100Model
      {
        Nr = id,
      };
      Model.SetMhrf(DialogTypeEnum.New, daten);
      var arr = HttpContext?.Session?.GetFormParameter() ?? [];
      var date = arr.Length > 0 ? Functions.ToDateTime(arr[0]) : null;
      var wpuid = arr.Length > 1 ? arr[1] : "";
      var kuid = arr.Length > 2 ? arr[2] : "";
      // Konfiguration lesen.
      if (date.HasValue)
        Model.Bis = date;
      if (!string.IsNullOrEmpty(wpuid))
        Model.Wertpapier = wpuid;
      var r = FactoryService.StockService.GetConfiguration(daten, kuid ?? "");
      if (r.Ok && !string.IsNullOrEmpty(kuid) && r.Ergebnis != null)
      {
        if (Model.Bis.HasValue)
          Model.Von = Model.Bis?.AddDays(-r.Ergebnis.Duration);
        Model.Box = r.Ergebnis.Box;
        Model.Skala = Functions.ToString(r.Ergebnis.Scale);
        Model.Umkehr = r.Ergebnis.Reversal;
        Model.Methode = Functions.ToString(r.Ergebnis.Method);
      }
    }
    Model.Nr = id;
    InitEditContext(Model);

    // Lesen der Listen für Auswahlfelder.
    var l0 = Get(FactoryService.StockService.GetStockList(daten));
    Model.AuswahlWertpapier = InsertEmpty(l0?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList());
    if (string.IsNullOrEmpty(Model.Wertpapier))
      Model.Wertpapier = GetStringData("WP100Wertpapier");
    var l1 = Get(FactoryService.StockService.GetScaleList(daten));
    Model.AuswahlSkala = l1?.Select(a => new ListItem(a.Schluessel, a.Wert)).ToList();
    var l2 = Get(FactoryService.StockService.GetMethodList(daten));
    Model.AuswahlMethode = l2?.Select(a => new ListItem(a.Schluessel, a.Wert)).ToList();
    var ld = Get(FactoryService.StockService.GetPriceList(daten, Model.Von ?? daten.Heute, Model.Bis ?? daten.Heute, Model.Wertpapier, Model.Relativ));
    ld?.Reverse(); // Sortierung: Datum absteigend
    //// Date;Date;Open_r;High_r;Low_r;Close_r
    Model.AuswahlData = ld?.Select(a => new ListItem(Functions.ToString(a.Datum), $"{Functions.ToString(a.Datum)} | {Functions.ToString(a.Open, 4)} | {Functions.ToString(a.High, 4)} | {Functions.ToString(a.Low, 4)} | {Functions.ToString(a.Close, 4)}")).ToList();
    var wpbez = string.IsNullOrEmpty(Model.Wertpapier) ? null : l0?.FirstOrDefault(a => a.Uid == Model.Wertpapier)?.Bezeichnung;
    ShowChart(true, ld, wpbez);
  }

  /// <summary>
  /// Initialisierung des Formulars kann wegen EditContext nicht asynchron sein:
  /// -Formular-Manager braucht eine Id, ansonsten Redirect mit neuer Guid.
  /// -Lesen des Models aus der Session, ansonsten Initialisierung des Models.
  /// </summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("WP100", "Point and Figure - WP100", Id, true))
      return;
    SetStringData("WP100Wertpapier", Model.Wertpapier);
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    if (IsDateMhp(submit, nameof(Model.Von), Model.Von, out var d))
    {
      if (d.HasValue)
      {
        Model.Von = d;
        WriteFormularModel(Model.Nr ?? "0", Model);
        Refresh();
      }
    }
    if (IsDateMhp(submit, nameof(Model.Bis), Model.Bis, out var db))
    {
      if (db.HasValue)
      {
        Model.Bis = db;
        WriteFormularModel(Model.Nr ?? "0", Model);
        Refresh();
      }
    }
    if (submit == nameof(Model.Schliessen))
      return true;
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(WP100Model model, WP100Model model0)
  {
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }

  /// <summary>Show chart data.</summary>
  /// <param name="init">Initial call or not.</param>
  /// <param name="kurse">Affected list of price data.</param>
  /// <param name="wpbez">Affected stock name.</param>
  /// <returns>True, if chart data is shown, otherwise false.</returns>
  private bool ShowChart(bool init = false, List<SoKurse>? kurse = null, string? wpbez = null)
  {
    var daten = ServiceDaten;
    if (string.IsNullOrEmpty(wpbez))
    {
      if (init)
      {
        #pragma warning disable CS8603
        Messages?.Add(() => Model.Wertpapier, $"Für Chartdaten muss ein Wertpapier ausgewählt werden.");
        #pragma warning restore CS8603
      }
      return false;
    }
    var ctx = new CanvasCompiler();
    ctx.AddControl(nameof(Model.Chart));
    var chart = new PnfChart(Functions.ToInt32(Model.Methode), Model.Box ?? 0, Functions.ToInt32(Model.Skala), Model.Umkehr ?? 1, wpbez ?? "Kein Wertpapier");
    chart.AddKurse(kurse);
    ChartPane.OnChartDraw(ctx, chart, Functions.ToInt32(CanvasWidth), Functions.ToInt32(CanvasHeight));
    CanvasDaten = ctx.Compile();
    return true;
  }
}