@page "/wp/wp260/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<WP260Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="wp260">
  @* <DataAnnotationsValidator/> *@
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <InputText type="hidden" @bind-Value="Model!.ReadonlyHiddenError"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Nummer)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Bezeichnung)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Wertpapier)" DataList="Model!.AuswahlWertpapier" VerticalColClass="form-group col-md-10"/>
    <SubmitButton class="btn btn-secondary col ms-1" For="@(() => Model!.Wpdetails)"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Status)" DataList="Model!.AuswahlStatus" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Depot)" DataList="Model!.AuswahlDepot" VerticalColClass="form-group col"/>
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Abrechnung)" DataList="Model!.AuswahlAbrechnung" VerticalColClass="form-group col-md-4"/>
    <LabelInputValid type="combobox" AutoPostback="" For="@(() => Model!.Ertrag)" DataList="Model!.AuswahlErtrag" VerticalColClass="form-group col-md-4 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid rows="2" AutoPostback="" For="@(() => Model!.Notiz)" VerticalColClass="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid rows="8" AutoPostback="" For="@(() => Model!.Data)" VerticalColClass="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Angelegt)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Geaendert)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Valuta)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Stand)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <SubmitButton class="btn btn-primary col-md-2 ms-1" For="@(() => Model!.Ok)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-x-lg" For="@(() => Model!.Abbrechen)"/>
  </div>
</EditForm>

@code {
  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id0">Betroffene Id mit vorangestelltem Dialogtyp.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id0, WP260Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    var (dt, id) = Formular.GetDtId(id0);
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new WP260Model
      {
        DialogType = dt,
        Nr = id,
      };
      if (dt == DialogTypeEnum.Edit || dt == DialogTypeEnum.Delete || dt == DialogTypeEnum.Copy)
      {
        Model.SetMhrf(dt, daten);
        var r = FactoryService.StockService.GetInvestment(daten, id ?? "");
        if (r.Ok && r.Ergebnis != null)
          Model.From(r.Ergebnis);
      }
      Model.SetMhrf(dt, daten);
    }
    Model.Nr = id;
    InitEditContext(Model);
    var l0 = Get(FactoryService.StockService.GetStockList(daten));
    Model.AuswahlWertpapier = InsertEmpty(l0?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList());
    Model.AuswahlWertpapier = l0?.Select(a => new ListItem(a.Uid, a.Bezeichnung)).ToList();
    var l1 = Get(FactoryService.StockService.GetStateList(daten));
    Model.AuswahlStatus = l1?.Select(a => new ListItem(a.Schluessel, a.Wert)).ToList();
    var kl = Get(FactoryService.BudgetService.GetAccountList(ServiceDaten, null, daten.Heute, daten.Heute));
    var keind = !kl?.Any(a => a.Kz == Constants.KZK_DEPOT) ?? true;
    Model.AuswahlDepot = kl?.Where(a => a.Art == Constants.ARTK_AKTIVKONTO && (keind || a.Kz == Constants.KZK_DEPOT)).Select(a => new ListItem(a.Uid, a.Name)).ToList();
    Model.AuswahlAbrechnung = kl?.Where(a => a.Art == Constants.ARTK_AKTIVKONTO).Select(a => new ListItem(a.Uid, a.Name)).ToList();
    Model.AuswahlErtrag = kl?.Where(a => a.Art == Constants.ARTK_ERTRAGSKONTO).Select(a => new ListItem(a.Uid, a.Name)).ToList();
  }

  /// <summary>Initialisierung der Komponente.</summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("WP260", "Anlage - WP260", Id, false))
      return;
  }
 
  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    var daten = ServiceDaten;
    if (submit == nameof(Model.Wpdetails))
    {
      // Formular WP210 Wertpapier öffnen
      var dt = Formular.ToShortString(DialogTypeEnum.Edit);
      var id2 = $"{dt}_{Model.Wertpapier}";
      var f = OpenFormular("WP210", id2);
      if (f != null)
        OpenFormular(f);
    }
    else if (valid && submit == nameof(Model.Ok))
    {
      var dt1 = Formular.GetTableDialogType(Model.ModalArt);
      var o = Model.To(daten);
      var st = Model.Stand ?? 0;
      if (dt1 == DialogTypeEnum.Delete)
      {
        var r = FactoryService.StockService.DeleteInvestment(daten, o);
        if (r.Ok)
        {
          Model.ModalArt = null;
          Model.ModalId = null;
          Refresh();
        }
        else
          Messages?.Add(() => Model, r.GetErrors());
      }
      else
      {
        var r = FactoryService.StockService.SaveInvestment(daten, o.Uid, o.Wertpapier_Uid, o.Bezeichnung, o.Notiz, o.State, o.PortfolioAccountUid, o.SettlementAccountUid, o.IncomeAccountUid, Model.Valuta, st);
        if (r.Ok && Model.Valuta.HasValue && st != 0 && r.Ergebnis != null)
        {
          var rs = StatusTask.HinzufuegenFunktion(daten.MandantNr, "CalculateInvestments", "1");
          r.AddMeldungen(rs);
          if (rs.Ok && rs.Ergebnis != null)
          {
            var state = rs.Ergebnis;
            Get(FactoryService.StockService.CalculateInvestments(daten, null, r.Ergebnis.Uid, null, Model.Valuta.Value, false, null, state));
            state.Beenden();
          }
        }
        if (r.Ok)
        {
          Model.ModalArt = null;
          Model.ModalId = null;
          Refresh();
          return true;
        }
        else
          Messages?.Add(() => Model, r.GetErrors());
      }
    }
    else if (IsDateMhp(submit, nameof(Model.Valuta), Model.Valuta, out var d))
    {
      Model.Valuta = d;
    }
    if (submit == nameof(Model.Abbrechen))
      return true;
    return false;
  }
}
