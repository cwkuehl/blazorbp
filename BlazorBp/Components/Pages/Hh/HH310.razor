@page "/hh/hh310/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<HH310Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnSubmit="Submit" FormName="hh310">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Nummer)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Bezeichnung)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Kennzeichen)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.EText)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="listbox" size="10" DataList="Model!.AuswahlSollkonto" AutoPostback="" For="@(() => Model!.Sollkonto)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid type="listbox" size="10" DataList="Model!.AuswahlHabenkonto" AutoPostback="" For="@(() => Model!.Habenkonto)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Angelegt)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Geaendert)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-primary col-md-2 ms-1" For="@(() => Model!.Ok)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Kontentausch)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Abbrechen)"/>
  </div>
</EditForm>

@code {
  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id0">Betroffene Id mit vorangestelltem Dialogtyp.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id0, HH310Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    var (dt, id) = Formular.GetDtId(id0);
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new HH310Model
      {
        DialogType = dt,
        Nr = id,
      };
      if (dt == DialogTypeEnum.Edit || dt == DialogTypeEnum.Delete || dt == DialogTypeEnum.Copy)
      {
        // Lesen des Models aus der Datenbank.
        var r = FactoryService.BudgetService.GetEvent(daten, id ?? "");
        if (r.Ok && r.Ergebnis != null)
          Model.From(r.Ergebnis);
      }
      Model.SetMhrf(dt);
    }
    Model.Nr = id;
    InitEditContext(Model);
    // Lesen der Listen für Auswahlfelder
    var l0 = Get(FactoryService.BudgetService.GetAccountList(daten, null, null));
    Model.AuswahlSollkonto = l0?.Select(a => new ListItem(a.Uid, a.Name)).ToList();
    Model.AuswahlHabenkonto = l0?.Select(a => new ListItem(a.Uid, a.Name)).ToList();
  }

  /// <summary>Initialisierung der Komponente.</summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("HH310", "Ereignis - HH310", Id, false))
      return;
  }
 
  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    var daten = ServiceDaten;
    if (valid && submit == nameof(Model.Ok))
    {
      var o = Model.To(daten);
      var r = Model.DialogType == DialogTypeEnum.Delete
        ? FactoryService.BudgetService.DeleteEvent(daten, o)
       : FactoryService.BudgetService.SaveEvent(daten, o.Uid, o.Kz, o.Soll_Konto_Uid, o.Haben_Konto_Uid, o.Bezeichnung, o.EText);
      if (r.Ok)
      {
        SetFormRefresh();
        return true;
      }
      else
        Get(r, Messages);
    }
    if (submit == nameof(Model.Kontentausch) && Model.DialogType != DialogTypeEnum.Delete)
    {
      var s = Model.Sollkonto;
      Model.Sollkonto = Model.Habenkonto;
      Model.Habenkonto = s;
    }
    if (submit == nameof(Model.Abbrechen))
      return true;
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(HH310Model model, HH310Model model0)
  {
    model.DialogType = model0.DialogType;
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }
}
