@page "/hh/hh510/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<HH510Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="hh510" enctype="multipart/form-data">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Titel)" maxlength="255" VerticalColClass="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Von)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="x" For="@(() => Model!.Bis)" VerticalColClass="form-group col-md-2 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="label" AutoPostback="" For="@(() => Model!.Berichte0)" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="checkbox" NoLabel="true" TrailingLabel="true" AutoPostback="x" For="@(() => Model!.Eb)" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="checkbox" NoLabel="true" TrailingLabel="true" AutoPostback="x" For="@(() => Model!.Gv)" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="checkbox" NoLabel="true" TrailingLabel="true" AutoPostback="x" For="@(() => Model!.Sb)" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-primary col-md-2 ms-1" href="@($"/downloadhtml/HH510BL/{Model!.Nr}")" download="bilanzen.html" For="@(() => Model!.Ok)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" href="@($"/downloadhtml/HH510KB/{Model!.Nr}")" download="kassenbericht.html" For="@(() => Model!.Kassenbericht)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Abbrechen)"/>
  </div>
  <div class="row mt-1 g-0">
    <input type="file" class="btn btn-secondary col-md-6" value="" name="filehochladen" id="filehochladen" multiple="multiple"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="checkbox" NoLabel="true" TrailingLabel="true" AutoPostback="" For="@(() => Model!.Loeschen)" VerticalColClass="form-group col-md-2"/>
    <SubmitButton class="btn btn-secondary col-md-4 ms-1" onclick="return confimp();" For="@(() => Model!.Import1)"/>
  </div>
</EditForm>

@code {

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id">Betroffene Id.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id, HH510Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new HH510Model
      {
        Nr = id,
      };
      Model.Titel = GetStringData("HH510Titel") ?? "Bilanzen";
      Model.SetMhrf(DialogTypeEnum.New);
      // Parameter auslesen.
      var arr = HttpContext?.Session?.GetFormParameter() ?? [];
      var kez = arr.Length > 0 ? Functions.ToString(arr[0]) : null;
      var v = arr.Length > 1 ? Functions.ToDateTime(arr[1]) : null;
      var b = arr.Length > 2 ? Functions.ToDateTime(arr[2]) : null;
      if (!string.IsNullOrEmpty(kez) && v.HasValue && b.HasValue)
      {
        // Model.Nr = kez;
        // id = kez;
        if (kez == Constants.KZBI_EROEFFNUNG)
        {
          Model.Von = v;
          Model.Bis = new DateTime(v.Value.Year, 12, 31);
          Model.Eb = true;
        }
        else if (kez == Constants.KZBI_SCHLUSS)
        {
          Model.Bis = v;
          Model.Von = b <= v ? b.Value.AddDays(1 - b.Value.DayOfYear) : new DateTime(v.Value.Year, 1, 1);
          Model.Sb = true;
        }
        else
        {
          Model.Von = v;
          Model.Bis = b;
          Model.Gv = true;
        }
        if (!(Model.Eb || Model.Gv || Model.Sb))
          Model.Sb = true;
      }
    }
    Model.Nr = id;
    InitEditContext(Model);
  }

  /// <summary>
  /// Initialisierung des Formulars kann wegen EditContext nicht asynchron sein:
  /// -Formular-Manager braucht eine Id, ansonsten Redirect mit neuer Guid.
  /// -Lesen des Models aus der Session, ansonsten Initialisierung des Models.
  /// </summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("HH510", "Drucken - HH510", Id, true))
      return;
    var submit = Model.Submit ?? "";
    if (submit == nameof(Model.Import1))
    {
      var l = SaveUploadFiles("HH510", "filehochladen");
      if (l != null)
      {
        var fn = l.FirstOrDefault();
        if (!string.IsNullOrEmpty(fn))
        {
          var cr = new CsvReader(fn);
          var lines = cr.GetLines();
          var message = Get(FactoryService.BudgetService.ImportBookingList(ServiceDaten, lines, Model.Loeschen));
          if (!string.IsNullOrEmpty(message))
            SetError(message);
        }
      }
    }
    SetStringData("HH510Titel", Model.Titel);
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    var daten = ServiceDaten;
    if (IsDateMhp(submit, nameof(Model.Von), Model.Von, out var dv))
    {
      Model.Von = dv;
    }
    else if (IsDateMhp(submit, nameof(Model.Bis), Model.Bis, out var db))
    {
      Model.Bis = db;
    }
    if (submit == nameof(Model.Abbrechen))
      return true;
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(HH510Model model, HH510Model model0)
  {
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }
}
