@page "/hh/hh100/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<HH100Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<EditForm Enhance method="post" EditContext="EditContext" OnValidSubmit="Submit" FormName="hh100">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row g-0">
    <div class="col-md-6">
      <div class="row mt-1 g-0">
        <LabelInputValid type="listbox" size="10" class="font-monospace" AutoPostback="" DataList="Model!.AuswahlPerioden" For="@(() => Model!.Perioden)" VerticalColClass="form-group col"/>
      </div>
    </div>
    <div class="col ms-1">
      <div class="row mt-1 g-0">
        <LabelInputValid AutoPostback="" For="@(() => Model!.Anfang)" maxlength="255" VerticalColClass="form-group col-md-2"/>
        <LabelInputValid AutoPostback="" For="@(() => Model!.Ende)" maxlength="255" VerticalColClass="form-group col-md-2 ms-1"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid type="radio" DataList="Model!.AuswahlLaenge" AutoPostback="" For="@(() => Model!.Laenge)" VerticalColClassxxx="form-group col-md-2"/>
      </div>
      <div class="row mt-1 g-0">
        <LabelInputValid type="radio" DataList="Model!.AuswahlArt" AutoPostback="" For="@(() => Model!.Art)" VerticalColClassxxx="form-group col-md-2"/>
      </div>
    </div>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-file-plus-button" For="@(() => Model!.New)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-file-x-button" For="@(() => Model!.Delete)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-arrow-clockwise" For="@(() => Model!.Refresh)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" imageclass="bi bi-x-lg" For="@(() => Model!.Schliessen)"/>
  </div>
</EditForm>

@code {

  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id">Betroffene Id.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id, HH100Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new HH100Model
      {
        Nr = id,
      };
      Model.SetMhrf(DialogTypeEnum.New);
      if (string.IsNullOrEmpty(Model.Laenge))
        Model.Laenge = GetStringData("HH100Length");
      if (string.IsNullOrEmpty(Model.Laenge))
        Model.Laenge = "1";
      if (string.IsNullOrEmpty(Model.Art))
        Model.Art = GetStringData("HH100When");
      if (string.IsNullOrEmpty(Model.Art))
        Model.Art = "1";
    }
    Model.Nr = id;
    InitEditContext(Model);
    Refresh();
    Model.AuswahlArt = new List<ListItem>
    {
      new ListItem("0", "Anfang"),
      new ListItem("1", "Ende"),
    };
    Model.AuswahlLaenge = new List<ListItem>
    {
      new ListItem("1", "Monatlich"),
      new ListItem("3", "Vierteljährlich"),
      new ListItem("6", "Halbjährlich"),
      new ListItem("12", "Jährlich"),
    };
  }

  /// <summary>
  /// Aktualisierung nach Undo/Redo.
  /// </summary>
  protected override void Refresh()
  {
    var daten = ServiceDaten;
    var l = Get(FactoryService.BudgetService.GetPeriodList(daten)) ?? new List<HhPeriode>();
    Model.AuswahlPerioden = l.Select(a => new ListItem(Functions.ToString(a.Nr), $"{a.Nr:00000} | {Functions.CutOrPadRight(Functions.ToString(a.Period),14, '\u00A0')} | {Functions.ToString(a.Datum_Von)} | {Functions.ToString(a.Datum_Bis)} | {Functions.ToString(a.Geaendert_Am, true)} | {a.Geaendert_Von} | {Functions.ToString(a.Angelegt_Am, true)} | {a.Angelegt_Von}")).ToList();
    if (l.Count > 0)
    {
      Model.Anfang = Functions.ToString(l.Last().Datum_Von);
      Model.Ende = Functions.ToString(l.First().Datum_Bis);
    }
  }

  /// <summary>
  /// Initialisierung des Formulars kann wegen EditContext nicht asynchron sein:
  /// -Formular-Manager braucht eine Id, ansonsten Redirect mit neuer Guid.
  /// -Lesen des Models aus der Session, ansonsten Initialisierung des Models.
  /// </summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("HH100", "Perioden - HH100", Id, true))
      return;
    SetStringData("HH100Length", Model.Laenge);
    SetStringData("HH100When", Model.Art);
  }

  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    if (valid && submit == "New")
    {
      var daten = ServiceDaten;
      if (Get(FactoryService.BudgetService.SavePeriod(daten, Functions.ToInt32(Model.Laenge), Functions.ToInt32(Model.Art) != 0)))
      {
        Refresh();
        DoPostbackReload();
      }
    }
    if (valid && submit == "Delete")
    {
      var daten = ServiceDaten;
      if (Get(FactoryService.BudgetService.DeletePeriod(daten, Functions.ToInt32(Model.Art) != 0)))
      {
        Refresh();
        DoPostbackReload();
      }
    }
    if (submit == nameof(Model.Schliessen))
      return true;
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(HH100Model model, HH100Model model0)
  {
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }
}
