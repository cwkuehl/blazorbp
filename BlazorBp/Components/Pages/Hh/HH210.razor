@page "/hh/hh210/{id?}"
@using CSBP.Services.Apis.Models
@inherits BlazorComponentBase<HH210Model, TableRowModelBase>
@attribute [Authorize(Roles = "User, Admin, Superadmin")]

<SectionContent SectionName="title">@Title</SectionContent>
<PageTitle>@Title</PageTitle>

<CascadingValue Value="this">
</CascadingValue>

<EditForm Enhance method="post" EditContext="EditContext" OnSubmit="Submit" FormName="hh210">
  <DataAnnotationsValidator/>
  <ValidationSummary class="text-danger"/>
  <InputText type="hidden" @bind-Value="Model!.Nr"/>
  <input type="hidden" name="SubmitControl"/>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Nummer)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Bezeichnung)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="radio" DataList="Model!.AuswahlKennzeichen" AutoPostback="" For="@(() => Model!.Kennzeichen)" VerticalColClassxxx="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid type="radio" DataList="Model!.AuswahlKontoart" AutoPostback="" For="@(() => Model!.Kontoart)" VerticalColClassxxx="form-group col"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Von)" VerticalColClass="form-group col-md-2"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Bis)" VerticalColClass="form-group col-md-2 ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid step="0.01" AutoPostback="" For="@(() => Model!.Betrag)" VerticalColClass="form-group col-md-2"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Angelegt)" VerticalColClass="form-group col-md-6"/>
    <LabelInputValid AutoPostback="" For="@(() => Model!.Geaendert)" VerticalColClass="form-group col ms-1"/>
  </div>
  <div class="row mt-1 g-0">
    <LabelInputValid AutoPostback="" For="@(() => Model!.Buchung)" VerticalColClass="form-group col"/>
  </div>
  <div class="modal-footer mt-2">
    <SubmitButton class="btn btn-primary col-md-2 ms-1" For="@(() => Model!.Ok)"/>
    <SubmitButton class="btn btn-secondary col-md-2 ms-1" For="@(() => Model!.Abbrechen)"/>
  </div>
</EditForm>

@code {
  /// <summary>
  /// Initialisierung des Models.
  /// </summary>
  /// <param name="id0">Betroffene Id mit vorangestelltem Dialogtyp.</param>
  /// <param name="model">Evtl. gelesenes Model.</param>
  /// <param name="table">Evtl. gelesenes Table-Model.</param>
  protected override void Init(string? id0, HH210Model? model = null, TableModelBase<TableRowModelBase>? table = null)
  {
    var daten = ServiceDaten;
    var (dt, id) = Formular.GetDtId(id0);
    if (model != null)
      Model = model;
    if (Model == null)
    {
      Model = new HH210Model
      {
        DialogType = dt,
        Nr = id,
      };
      if (dt == DialogTypeEnum.Edit || dt == DialogTypeEnum.Delete || dt == DialogTypeEnum.Copy)
      {
        // Lesen des Models aus der Datenbank, z.B.:
        var r = FactoryService.BudgetService.GetAccount(daten, id ?? "");
        if (r.Ok && r.Ergebnis != null)
          Model.From(r.Ergebnis);
      }
      Model.SetMhrf(dt);
    }
    Model.Nr = id;
    InitEditContext(Model);
    // Lesen der Listen für Auswahlfelder.
    Model.Buchung = Get(FactoryService.BudgetService.GetBookingSpan(daten, Model.Nr ?? ""));
    Model.AuswahlKennzeichen = new List<ListItem>
    {
      new ListItem("", "Ohne Kennzeichen"),
      new ListItem(Constants.KZK_EK, "Eigenkapitel-Konto"),
      new ListItem(Constants.KZK_GV, "Gewinn+Verlust-Konto"),
      new ListItem(Constants.KZK_DEPOT, "Depot-Konto"),
    };
    Model.AuswahlKontoart = new List<ListItem>
    {
      new ListItem(Constants.ARTK_AKTIVKONTO, "Aktiv (AK)"),
      new ListItem(Constants.ARTK_PASSIVKONTO, "Passiv (PK)"),
      new ListItem(Constants.ARTK_AUFWANDSKONTO, "Aufwand (AW)"),
      new ListItem(Constants.ARTK_ERTRAGSKONTO, "Ertrag (ER)"),
    };
  }

  /// <summary>Initialisierung der Komponente.</summary>
  protected override void OnInitialized()
  {
    if (OnInitializedFormular("HH210", "Konto - HH210", Id, false))
      return;
  }
 
  /// <summary>
  /// Verarbeitung des Postbacks.
  /// </summary>
  /// <param name="submit">Betroffener Submit-Parameter.</param>
  /// <returns>True, wenn das Formular geschlossen werden soll, sonst false.</returns>
  protected override bool Submit(string? submit)
  {
    var daten = ServiceDaten;
    if (valid && submit == nameof(Model.Ok))
    {
      var o = Model.To(daten);
      var r = Model.DialogType == DialogTypeEnum.Delete
        ? FactoryService.BudgetService.DeleteAccount(daten, o)
        : FactoryService.BudgetService.SaveAccount(daten, o.Uid, o.Art, o.Kz, o.Name, o.Gueltig_Von, o.Gueltig_Bis, o.EBetrag);
      if (r.Ok)
      {
        Model.ModalArt = null;
        Model.ModalId = null;
        SetFormRefresh();
        return true;
      }
      else
        Get(r, ModalMessages);
    }
    if (submit == nameof(Model.Abbrechen))
      return true;
    return false;
  }

  /// <summary>
  /// Kopieren von Daten im Model, die nicht über Postback gesendet werden.
  /// </summary>
  /// <param name="model">Betroffenes Model, das geändert werden soll.</param>
  /// <param name="model0">Model, aus dem kopiert werden soll.</param>
  protected override void CopyNotPostbackData(HH210Model model, HH210Model model0)
  {
    model.DialogType = model0.DialogType;
    model.ReadonlyHiddenError = model0.ReadonlyHiddenError;
  }
}
