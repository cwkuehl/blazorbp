@using BlazorBp.Core.Modules
@inject IEnumerable<IFormModule> FormModules
@inject AuthenticationStateProvider AuthStateProvider

<header>
  <div class="border border-2 border-secondary rounded-3 bg-info-subtle mt-1">
    <NavLink class="navbar-brand ms-1" href="" Match="NavLinkMatch.All" title="Blazor Haushaltsprogramm 2026"><span class="bi bi-house-door-nav-menu" aria-hidden="true"></span>Blazor HH</NavLink>
  </div>
</header>
<div class="border border-2 border-secondary rounded-3 mt-1">
  <Header></Header>
</div>
<div class="border border-2 border-secondary rounded-3 mt-1 mb-1">
  <span class="ms-1 fw-bold">Menü</span>
  <AuthorizeView>&nbsp;</AuthorizeView><!-- Stehenlassen, sonst wird Menü nach Anmeldung nicht angezeigt. -->
  @foreach (var menu in _visibleMenues ?? Enumerable.Empty<MainMenu>())
  {
    <NavLink class="nav-link ms-1" href="#" title=@($"Menü {menu.Key}") data-bs-toggle="collapse" data-bs-target=@($"#{menu.SubKey}") aria-expanded="false" aria-controls="@menu.SubKey")><span class="@menu.Icon" aria-hidden="true"></span>@menu.Key</NavLink>
    <div class=@($"collapse {(menu.Expanded ? "show" : "")} ms-3") id="@menu.SubKey">
    @foreach (var entry in menu.Entries)
    {
      <NavLink class="nav-link" href="@entry.Route" title="@entry.Description" aria-label="@entry.Description"><span class="@entry.Icon" aria-hidden="true"></span>@entry.Text</NavLink>
    }
    </div>
  }
  <NavLink class="nav-link ms-1" href="impressum" title="Verwendung der Daten"><span class="bi bi-incognito-nav-menu" aria-hidden="true"></span>Impressum</NavLink>
</div>
<OpenForms/>

@code {
  [Parameter]
  public bool Interactive { get; set; }

  private List<MainMenu>? _visibleMenues;

  protected override async Task OnInitializedAsync()
  {
    if (!Interactive)
      Funktionen.MachNichts();
    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;
    var isAuthenticated = user.Identity?.IsAuthenticated ?? false;

    _visibleMenues = FormModules
      .SelectMany(module => module.GetMainMenues())
      .Where(menu => isAuthenticated && (menu.RequiredRoles == null || !menu.RequiredRoles.Any() || menu.RequiredRoles.Any(user.IsInRole)))
      .Select(menu => menu with
      {
        Entries = menu.Entries
          .Where(entry => entry.RequiredRole is null || user.IsInRole(entry.RequiredRole))
          .ToList()
      })
      .Where(menu => menu.Entries.Any()) // leere Menüs nicht anzeigen
      .OrderBy(menu => menu.SortOrder)
      .ThenBy(menu => menu.Key)
      .ToList();
  }
}
