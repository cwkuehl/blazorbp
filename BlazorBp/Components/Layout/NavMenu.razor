      <NavLink class="nav-link" href="en/en100" title="Abfrage-Parameter" aria-label="Abfrage-Parameter"><span class="bi bi-dot-nav-menu" aria-hidden="true"></span>Abfrage-Parameter</NavLink>
    </div>
  </AuthorizeView>
  @foreach (var (module, entries) in _visibleModules ?? Enumerable.Empty<(IFormModule, List<MenuEntry>)>())
  {
    if (entries.Count == 0)
      continue;
    <NavLink class="nav-link ms-1" href="#" title=@($"Menü {module.Key}") data-bs-toggle="collapse" data-bs-target=@($"#{module.SubKey}") aria-expanded="false" aria-controls="@module.SubKey")><span class="@module.Icon" aria-hidden="true"></span>@module.Key</NavLink>
    <div class=@($"collapse {(module.Expanded ? "show" : "")} ms-3") id="@module.SubKey">
      @foreach (var entry in entries)
      {
        <NavLink class="nav-link" href="@entry.Route" title="@entry.Description" aria-label="@entry.Description"><span class="@entry.Icon" aria-hidden="true"></span>@entry.Text</NavLink>
      }
    </div>
  }
  <NavLink class="nav-link ms-1" href="impressum" title="Verwendung der Daten"><span class="bi bi-incognito-nav-menu" aria-hidden="true"></span>Impressum</NavLink>
</div>
<OpenForms/>

@code {
  [Parameter]
  public bool Interactive { get; set; }

  private List<(IFormModule Module, List<MenuEntry> Entries)>? _visibleModules;

  protected override async Task OnInitializedAsync()
  {
    if (!Interactive)
      Functions.MachNichts();
    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;

    _visibleModules = FormModules
      .Where(m => m.RequiredRoles.Any(role => user.IsInRole(role)) || !m.RequiredRoles.Any())
      .Select(m => (
          Module: m,
          Entries: m.GetMenuEntries().Where(a => a.RequiredRole is null || user.IsInRole(a.RequiredRole)).ToList()
      ))
      .Where(a => a.Entries.Count > 0)
      .OrderBy(a => a.Module.SortOrder)
      .OrderBy(a => a.Module.Key)
      .ToList();
  }
}
