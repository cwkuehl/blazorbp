  <AuthorizeView Roles="xxx">
    <NavLink class="nav-link ms-1" href="#" title="Menü Energie" data-bs-toggle="collapse" data-bs-target="#submenuenergy" aria-expanded="false" aria-controls="submenuprivate"><span class="bi bi-person-nav-menu" aria-hidden="true"></span>Energie</NavLink>
